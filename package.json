{
  "name": "lumen",
  "productName": "Lumen",
  "version": "0.1.0",
  "description": "A calm, thorough cleaner for your Mac",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "icon": "electron scripts/make-icon.cjs",
    "dry-run": "LUMEN_DRY_RUN=1 vitest run tests/dryRun.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "d3-shape": "^3.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "motion": "^14.9.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "license": "MIT",
  "author": {
    "name": "Sabbir Rifat"
  },
  "homepage": "https://github.com/sabbirrifat/lumen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sabbirrifat/lumen.git"
  },
  "bugs": {
    "url": "https://github.com/sabbirrifat/lumen/issues"
  },
  "keywords": [
    "macos",
    "cleaner",
    "disk-space",
    "developer-tools",
    "electron",
    "react"
  ]
}
